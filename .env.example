# Puerto Rico Tax Copilot — environment variables
# The app runs in LOCAL MODE (browser localStorage) when Supabase vars are absent,
# so you can demo Phases 1-3 without any backend. Set these to enable real Supabase.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI (Phase 4 extraction; not required for Phases 1-3) ---
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.5

# --- Stripe (Phase 7 billing; not required for Phases 1-3) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- App ---
APP_URL=http://localhost:3000
TRIAL_DAYS=7
